/scripts/
/data/
/docs/
/tests/
/Makefile
/pyproject.toml
/uv.lock
__pycache__/
*.py[cod]
.venv/

# Raw race data may contain personal data (names, bibs). Only anonymized
# JSON (gender/age/group/time, no identifiers) belongs in assets/data/.
assets/data/*.csv
